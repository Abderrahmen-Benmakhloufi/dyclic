# Example Environment Configuration — .env.example
# NEVER commit real API keys or secrets to Git!

# Supabase Project Configuration (for Flutter Client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Secrets (Configured ONLY in Supabase Dashboard or via CLI, NEVER in client)
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-api-key-here
CLAUDE_MODEL=claude-3-5-haiku-20241022
